# InfluxDB & Dashboard Credentials - Example File
# Copy this file to .env and customize the values

# InfluxDB Admin Credentials
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=your-secure-password-here

# InfluxDB Configuration
INFLUXDB_ORG=healthcare
INFLUXDB_BUCKET=eeg_data
INFLUXDB_ADMIN_TOKEN=your-secure-token-here

# Security Notes:
# - Use a strong password with at least 3 special characters
# - Never commit .env to version control
# - Rotate credentials regularly in production
# - Example strong password: H3@lthC@re!2026
# - Example strong token: hc-eeg-secure-t0ken!2026@api
